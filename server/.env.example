# Copia este archivo como server/.env y llena tus datos. El .env NUNCA se sube al repo.

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pos_olimpo

# Firma de las sesiones: cualquier texto largo y secreto
JWT_SECRET=

# Cuenta de Gmail que manda la bienvenida al dar de alta a un empleado.
# CORREO_CONTRASENA_APP NO es la contraseña normal de la cuenta: es una "contraseña de
# aplicación" de 16 letras que se genera en myaccount.google.com/apppasswords
# (antes hay que activar la verificación en dos pasos de esa cuenta).
CORREO_USUARIO=
CORREO_CONTRASENA_APP=

# Dirección del sistema que va en el enlace del correo para confirmar los términos
# (la página /confirmar-lectura). En desarrollo, la de ng serve.
APP_URL=http://localhost:4300
